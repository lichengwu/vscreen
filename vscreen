#!/bin/zsh
# ============================================================================
# vscreen — headless Mac 虚拟屏，匹配远程客户端设备（RustDesk 友好）
#
# 永远只维护一块名为 "vscreen" 的虚拟屏：切换设备/分辨率时复用同一块、
# 覆盖分辨率列表与活动档，绝不新建。这个名字本身就是“本工具创建”的标识。
#
# 选定设备/分辨率后自动完成：
#   1. 确保名为 "vscreen" 的虚拟屏存在并连接（其他虚拟屏自动断开，远程端只见一块屏）
#   2. 设置匹配分辨率（HiDPI，默认全屏补偿档，消除黑边）
#   3. 设为主显示器；默认把其他物理显示器镜像到它（--no-mirror 可关闭）
#
# 用法：
#   vscreen <设备别名>[@系数]      # 补偿档（默认，全屏无黑边），可带缩放系数
#   vscreen <设备别名>-native[@系数]
#   vscreen <设备别名>-full[@系数]
#   vscreen <WxH>[@系数]           # 直接分辨率；W/H 之间可用 x/X/空格（1512 945）
#   vscreen off                   # 断开所有虚拟屏、解除镜像（恢复纯物理显示）
#   vscreen status                # 查看当前所有显示器状态
#   vscreen list                  # 列出支持的设备与三档分辨率
#   vscreen update                # 从 GitHub 自更新（检测版本，相同则跳过）
#   vscreen version | -v | --version   # 查看版本号
#   vscreen -h | --help           # 帮助
#
# 选项：
#   --no-mirror                   # 不镜像物理显示器（保持扩展桌面模式）
#   --print                       # 只预览将设置的分辨率，不修改显示器
# 系数写法：125% / 1.25 / 80；125% = 内容放大 = 分辨率等比 ÷1.25（空格/小数均宽限）
#
# 依赖：BetterDisplay（/Applications/BetterDisplay.app）、python3、zsh
# 项目：https://github.com/lichengwu/vscreen
# ============================================================================

set -euo pipefail

BD="/Applications/BetterDisplay.app/Contents/MacOS/BetterDisplay"
REPO="lichengwu/vscreen"
# VSCREEN_RAW_URL 可注入 file:// 假远端（测试用）；默认走 GitHub raw
RAW_URL="${VSCREEN_RAW_URL:-https://raw.githubusercontent.com/$REPO/main/vscreen}"
# zsh 函数内 $0 = 函数名，须在顶层捕获真实脚本路径（update 的 mv 目标）
SCRIPT_PATH="$0"
VERSION="1.1.3"

# 本工具管理的唯一虚拟屏名（= “本工具创建”的身份标识，固定不变）
SCREEN_NAME="vscreen"

# --- 设备 → 分辨率映射表（增删设备改这里）---
# 格式：别名="设备名|native 逻辑|compensated 补偿|full 1:1"
#   compensated = native 高度 − 菜单栏（刘海机型 37pt，普通机型 24pt）
#   ⚠️ MacBook Air（M2+）：出厂默认档是“缩放档”而非 2x 逻辑——
#      mba13 默认 1470x956（非 1280x832），mba15 默认 1710x1107（非 1440x932）。
#      且 M2+ Air 有刘海：菜单栏按默认缩放换算 37pt(13")/38pt(15")。
typeset -A DEVICES
DEVICES=(
  mba13     "MacBook Air 13|1470x956|1470x919|2560x1664"
  mba15     "MacBook Air 15|1710x1107|1710x1069|2880x1864"
  mbp14     "MacBook Pro 14|1512x982|1512x945|3024x1964"
  mbp16     "MacBook Pro 16|1728x1117|1728x1080|3456x2234"
  imac24    "iMac 24|2240x1260|2240x1236|4480x2520"
  studio    "Studio Display|2560x1440|2560x1416|5120x2880"
  xdr       "Pro Display XDR|3008x1692|3008x1668|6016x3384"
  # iPad：iPadOS 全屏满血无菜单栏，故 compensated == native（不减）
  ipadpro13  "iPad Pro 13|1376x1032|1376x1032|2752x2064"
  ipadpro129 "iPad Pro 12.9|1366x1024|1366x1024|2732x2048"
  ipadair13  "iPad Air 13|1366x1024|1366x1024|2732x2048"
)

# 设备别名同义词
typeset -A SYNONYMS
SYNONYMS=(
  air13      mba13
  air15      mba15
  pro14      mbp14
  pro16      mbp16
  imac       imac24
  prodisplay  xdr
  xdr6k       xdr
  # iPad 同义词
  pro13       ipadpro13
  pro129      ipadpro129
  ipadair     ipadair13
  ipad13      ipadair13
)

# 列表展示用的稳定顺序
DEVICE_ORDER=(mba13 mba15 mbp14 mbp16 imac24 studio xdr ipadpro13 ipadpro129 ipadair13)

# ---------- 帮助 ----------
print_help() {
  echo "vscreen v$VERSION — headless Mac 虚拟屏，匹配远程客户端设备（RustDesk 友好）"
  echo
  cat <<'EOF'
用法：
  vscreen <设备>[@系数]        匹配设备，用补偿档（全屏无黑边，默认）
  vscreen <设备>-native[@系数] 用原生逻辑分辨率
  vscreen <设备>-full[@系数]   用 1:1 物理档
  vscreen <WxH>[@系数]         直接按分辨率（W、H 间可用 x / X / 空格）
  vscreen off                 断开所有虚拟屏、解除镜像
  vscreen status              查看当前显示器状态
  vscreen list                列出支持的设备与三档分辨率
  vscreen update              检测并自更新（已是最新则跳过）
  vscreen version | -v | --version   查看版本号
  vscreen -h | --help         显示本帮助

选项：
  --no-mirror                 不镜像物理屏（保持扩展桌面模式）
  --print                     只预览将设置的分辨率，不修改显示器

缩放系数（@后缀）：
  125% / 1.25 / 80 等价（无 % 且 >3 视为百分数），范围 25%–400%
  125% = 内容放大 25%：分辨率等比 ÷1.25，宽高比不变
  空格宽限：mba13@125% = mba13 @125% = mba13 @ 125%；WxH 带小数自动取整

设备别名：
  mba13      MacBook Air 13"      mba15      MacBook Air 15"
  mbp14      MacBook Pro 14"      mbp16      MacBook Pro 16"
  imac24     iMac 24"            studio     Studio Display
  xdr        Pro Display XDR
  ipadpro13  iPad Pro 13"        ipadpro129 iPad Pro 12.9"
  ipadair13  iPad Air 13"

示例：
  vscreen mbp14                # 从 MacBook Pro 14 远程 → 1512x945
  vscreen mba13@125%           # 内容放大 25%：1470x919 → 1176x735
  vscreen 1512 945             # 空格分隔，等价 1512x945
  vscreen ipadpro13            # 从 iPad Pro 13 远程 → 1376x1032

项目：https://github.com/lichengwu/vscreen
EOF
}

usage() { print_help; exit 0; }
die() { echo; echo "错误：$1" >&2; echo >&2; print_help >&2; exit 1; }

# ---------- 解析设备别名 → 设置 S_LIST / S_RES ----------
# 返回 0 成功，1 未识别。export S_LIST S_RES 给调用方。
resolve_device() {
  local key="$1" suffix=""
  # 剥离 -native / -full 后缀
  if [[ "$key" == *"-native" ]]; then suffix="native"; key="${key%-native}"
  elif [[ "$key" == *"-full" ]]; then suffix="full"; key="${key%-full}"; fi
  # 同义词归一
  [[ -n "${SYNONYMS[$key]:-}" ]] && key="${SYNONYMS[$key]}"
  local entry="${DEVICES[$key]:-}"
  [[ -z "$entry" ]] && return 1

  local -a parts=("${(@s/|/)entry}")
  local name="${parts[1]}" native="${parts[2]}" comp="${parts[3]}" full="${parts[4]}"
  case "$suffix" in
    native) S_RES="$native"; S_DESC="$key native 档" ;;
    full)   S_RES="$full";   S_DESC="$key full 档" ;;
    *)      S_RES="$comp";   S_DESC="$key 补偿档" ;;
  esac
  S_LIST="$comp,$native,$full"
  return 0
}

# ---------- 缩放 ----------
# 等比缩放：两维同除 k 后就近取整。宽高比由构造保持（两维同系数），
# 取整各自最多偏半像素，比例偏差 <0.1%。
scale_resolution() {  # $1=WxH  $2=k → stdout: 新 WxH
  local -a wh=("${(@s/x/)1}")
  awk -v w="${wh[1]}" -v h="${wh[2]}" -v k="$2" \
    'BEGIN{ printf "%dx%d", int(w/k+0.5), int(h/k+0.5) }'
}

# 小数 WxH 就近取整（“1336.36x835.45” → “1336x835”）
round_resolution() {  # $1=WxH（可含小数） → stdout: 整数 WxH
  local -a wh=("${(@s/x/)1}")
  awk -v w="${wh[1]}" -v h="${wh[2]}" 'BEGIN{ printf "%dx%d", int(w+0.5), int(h+0.5) }'
}

# --- 参数解析 ---
NO_MIRROR=false
PRINT=false
ARG=""
SCALE=""      # @系数原始输入（如 125%）
SCALE_K=""    # 归一化系数（如 1.25）
S_BASE=""     # 缩放前基准（--print 展示用）
S_DESC=""     # 档位描述（--print 展示用）

# 预处理（宽限输入）：
#   “1512 945”     → “1512x945”   （x 在中文输入法/软键盘要切层，空格零成本）
#   “mba13 @125%”  → “mba13@125%"
#   “mba13 @ 125%” → “mba13@125%” （@ 与系数间也有空格）
ARGV=("$@")
ARGS=()
lastpos=0    # ARGS 中最后一个位置参数（非旗标）的下标
i=1
while (( i <= $#ARGV )); do
  a="${ARGV[i]}"
  # 旗标原样透传
  if [[ "$a" == -* ]]; then
    ARGS+=("$a"); (( i+=1 )); continue
  fi
  # @系数：并入最后一个位置参数（“mba13 @125%” / “mba13 @ 125%”）
  if [[ "$a" == "@"* && $lastpos -ge 1 ]]; then
    if [[ "$a" == "@" ]]; then
      if (( i < $#ARGV )) && [[ "${ARGV[i+1]}" =~ ^[0-9.]+%?$ ]]; then
        a="@${ARGV[i+1]}"; (( i+=1 ))
      else
        ARGS+=("$a"); (( i+=1 )); continue   # @ 后面不是系数 → 后续报“系数为空”
      fi
    fi
    ARGS[$lastpos]="${ARGS[$lastpos]}${a}"
    (( i+=1 )); continue
  fi
  # 相邻数字参数拼成 WxH（允许小数：“1336.36 835.45”）
  if [[ $lastpos -ge 1 && "${ARGS[$lastpos]}" =~ ^[0-9]+([.][0-9]+)?$ \
        && "$a" =~ ^[0-9]+([.][0-9]+)?(@[0-9.]+%?)?$ ]]; then
    ARGS[$lastpos]="${ARGS[$lastpos]}x${a}"
  else
    ARGS+=("$a")
    lastpos=${#ARGS}
  fi
  (( i+=1 ))
done

POS_COUNT=0
for a in "${ARGS[@]}"; do
  case "$a" in
    --no-mirror)   NO_MIRROR=true ;;
    --print)       PRINT=true ;;
    -h|--help)     usage ;;
    -v|--version)  ARG="version" ;;
    *)
      # 一次只接受一个位置参数：静默“后者覆盖前者”会吞掉系数（如 @125% mba13）
      POS_COUNT=$((POS_COUNT+1))
      (( POS_COUNT > 1 )) && die "一次只能指定一个设备/WxH（多余参数 \"$a\"）；系数请写成 mba13@125%"
      ARG="$a" ;;
  esac
done

# 剥离 @系数 后缀（可出现在设备别名或 WxH 之后）
if [[ "$ARG" == *"@"* ]]; then
  SCALE="${ARG##*@}"
  [[ -n "$SCALE" ]] || die "缩放系数为空（写法：mba13@125%）"
  ARG="${ARG%@*}"
  SF_RAW="${SCALE//\%/}"
  [[ "$SF_RAW" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "无效缩放系数 \"$SCALE\"（写法：125% / 1.25 / 80）"
  SCALE_K=$(awk -v s="$SF_RAW" 'BEGIN{ if (s+0>3) s=s/100; printf "%.6g", s+0 }')
  awk -v k="$SCALE_K" 'BEGIN{ exit !(k>=0.25 && k<=4) }' || die "缩放系数 $SCALE 超出范围（25%–400%）"
fi

MODE="apply"
S_LIST=""; S_RES=""
case "$ARG" in
  "")         die "缺少参数（<设备|WxH|off|status|list|update|version>）" ;;
  off|none)   MODE="off" ;;
  status)     MODE="status" ;;
  list)       MODE="list" ;;
  update)     MODE="update" ;;
  version)    MODE="version" ;;
  *)
    if [[ "$ARG" =~ ^[0-9]+([.][0-9]+)?[xX][0-9]+([.][0-9]+)?$ ]]; then
      # 直接给分辨率：列表里只放这一档（X 统一小写，小数就近取整）
      S_RES=$(round_resolution "${ARG//X/x}"); S_LIST="$S_RES"; S_DESC="自定义分辨率"
    elif resolve_device "$ARG"; then
      :  # S_LIST / S_RES / S_DESC 已由 resolve_device 设置
    else
      die "未知参数 \"$ARG\"（应为设备别名、WxH 或 off/status/list/update/version）"
    fi
    ;;
esac

# 系数 / --print 只对“设置分辨率”路径有意义
if [[ -n "$SCALE" && "$MODE" != "apply" ]]; then
  die "缩放系数只能搭配设备或 WxH（如 mba13@125%），不能与 \"$ARG\" 搭配"
fi
if [[ "$PRINT" == true && "$MODE" != "apply" ]]; then
  die "--print 只用于预览设备 / WxH 的分辨率换算"
fi

# 应用缩放：等比 ÷k、就近取整（宽高比不变）
if [[ -n "$SCALE_K" ]]; then
  S_BASE="$S_RES"
  S_RES=$(scale_resolution "$S_RES" "$SCALE_K")
  S_LIST="$S_RES"   # 缩放档自成一体（与直接 WxH 同理）
fi

# ---------- BetterDisplay 前置检查 ----------
ensure_bd() {
  if [[ ! -x "$BD" ]]; then
    echo "错误：未找到 BetterDisplay CLI（${BD}）" >&2
    echo "安装：brew install --cask betterdisplay 或 https://betterdisplay.pro" >&2
    exit 1
  fi
  # BetterDisplay 未运行则启动（CLI 依赖主进程）
  if ! pgrep -x BetterDisplay >/dev/null; then
    echo "启动 BetterDisplay ..."
    open -a BetterDisplay
    sleep 5
  fi
}

# ---------- 工具函数 ----------
# 注意：被 $( ) 捕获的函数只能向 stdout 输出返回值，日志一律走 stderr

# 列出所有显示器：tagID<TAB>类型<TAB>名称
list_displays() {
  "$BD" get --identifiers 2>/dev/null | python3 -c '
import sys, json, re
raw = sys.stdin.read()
for m in re.finditer(r"\{[^{}]*\}", raw, re.S):
    try:
        o = json.loads(m.group(0))
    except Exception:
        continue
    print("%s\t%s\t%s" % (o.get("tagID", ""), o.get("deviceType", ""), o.get("name", "")))
'
}

# 按名称查找虚拟屏 tagID
find_tag() {
  list_displays | awk -F'\t' -v n="$1" '$2=="VirtualScreen" && $3==n {print $1; exit}'
}

# 除指定名称外的虚拟屏 tagID 列表
virtual_tags_except() {
  list_displays | awk -F'\t' -v n="$1" '$2=="VirtualScreen" && $3!=n {print $1}'
}

# 物理显示器 tagID 列表
physical_tags() {
  list_displays | awk -F'\t' '$2=="Display" {print $1}'
}

# 读取虚拟屏当前档位（只取列表内的 WxH；无匹配返回空）
get_current_res() {
  local tag=$1 list=$2 r
  for r in $( "$BD" get -tagID="$tag" -resolution 2>/dev/null | grep -oE '[0-9]+x[0-9]+' || true ); do
    if [[ "$list" == *"$r"* ]]; then
      echo "$r"
      return 0
    fi
  done
  return 0
}

# 单值查询（失败返回 "-"）
qget() {
  local v
  v=$("$BD" get -tagID="$1" "$2" 2>/dev/null || true)
  echo "${v:-"-"}"
}

# 状态总览
show_status() {
  echo "当前显示器状态："
  list_displays | while IFS=$'\t' read -r tag type name; do
    [[ -z "$tag" ]] && continue
    res=$("$BD" get -tagID="$tag" -resolution 2>/dev/null | grep -oE '[0-9]+x[0-9]+' | head -1 || true)
    printf "  %-20s %-13s %-10s main=%-6s mirror=%s\n" \
      "$name" "[$type]" "${res:--}" \
      "$(qget "$tag" -main)" \
      "$(qget "$tag" -mirror)"
  done
}

# 解除一块屏的镜像（静默容忍）
unmirror() {
  "$BD" set -tagID="$1" -mirror=off >/dev/null 2>&1 || true
}

# ---------- 模式实现 ----------

do_list() {
  echo "支持的设备（默认用 compensated 补偿档，全屏无黑边）："
  echo
  printf "  %-8s %-20s %-16s %-16s %s\n" "别名" "设备" "compensated" "native" "full(1:1)"
  local key entry
  for key in "${DEVICE_ORDER[@]}"; do
    entry="${DEVICES[$key]}"
    local -a parts=("${(@s/|/)entry}")
    printf "  %-8s %-20s %-16s %-16s %s\n" \
      "$key" "${parts[1]}" "${parts[3]}" "${parts[2]}" "${parts[4]}"
  done
  echo
  echo "用法：vscreen <别名> | <别名>-native | <别名>-full | <WxH>"
  echo "示例：vscreen mbp14         # 1512x945（补偿档）"
  echo "      vscreen mbp14-native  # 1512x982（原生逻辑）"
  echo "      vscreen 1512x945      # 直接按分辨率"
}

do_apply() {
  # --print：只打印换算结果，不触碰 BetterDisplay / 显示器
  if [[ "$PRINT" == true ]]; then
    if [[ -n "$SCALE_K" ]]; then
      echo "${S_DESC} ${S_BASE} @ ${SCALE} → ${S_RES} (HiDPI)"
    else
      echo "${S_DESC} → ${S_RES} (HiDPI)"
    fi
    return 0
  fi
  ensure_bd
  local tag cur

  # 1. 确保名为 "vscreen" 的虚拟屏存在（复用，绝不新建第二块）
  tag=$(find_tag "$SCREEN_NAME")
  if [[ -z "$tag" ]]; then
    echo "创建虚拟屏 \"$SCREEN_NAME\" ..."
    "$BD" create -type=VirtualScreen \
      -virtualScreenName="$SCREEN_NAME" \
      -useResolutionList=on \
      -resolutionList="$S_LIST" \
      -virtualScreenHiDPI=on
    sleep 2
    tag=$(find_tag "$SCREEN_NAME")
    if [[ -z "$tag" ]]; then
      echo "错误：\"$SCREEN_NAME\" 创建后未能定位" >&2
      exit 1
    fi
  else
    # 已存在 → 复用：整体覆盖分辨率列表（切换设备时更新模板，不新建）
    "$BD" set -tagID="$tag" -resolutionList="$S_LIST" >/dev/null 2>&1 || true
    sleep 1
  fi

  # 2. 连接目标虚拟屏，断开其他虚拟屏（远程端只看到一块屏）
  "$BD" set -tagID="$tag" -connected=on >/dev/null 2>&1 || true
  local others
  others=$(virtual_tags_except "$SCREEN_NAME")
  if [[ -n "$others" ]]; then
    echo "断开其他虚拟屏 ..."
    # zsh 不对未加引号的 $var 分词——多行 tag 列表必须用 ${(f)…} 按行切
    for t in ${(f)others}; do
      "$BD" set -tagID="$t" -connected=off >/dev/null 2>&1 || true
    done
    sleep 2
  fi

  # 3. 设置分辨率（CLI 怪癖：设相同分辨率返回 Failed，只在变化时设置）
  cur=$(get_current_res "$tag" "$S_LIST")
  if [[ "$cur" != "$S_RES" ]]; then
    echo "设置分辨率：${cur:-?} -> $S_RES (HiDPI)"
    "$BD" set -tagID="$tag" -resolution="$S_RES" -hiDPI=on
    sleep 2
  fi

  # 4. 清掉所有现有镜像，避免残留镜像组干扰（${(f)…}：zsh 不分词，见上）
  local alltags
  alltags=$(list_displays | cut -f1)
  for t in ${(f)alltags}; do unmirror "$t"; done
  sleep 2

  # 5. 设为主显示器
  echo "设置 \"$SCREEN_NAME\" 为主显示器 ..."
  "$BD" set -tagID="$tag" -main=on
  sleep 1

  # 6. 镜像物理显示器到虚拟屏（镜像语义：在主屏上调用，target 指向被镜像屏）
  if [[ "$NO_MIRROR" == "false" ]]; then
    local phys
    phys=$(physical_tags)
    for p in ${(f)phys}; do
      echo "镜像物理屏 tagID=$p -> $SCREEN_NAME"
      "$BD" set -tagID="$tag" -mirror=on -targetTagID="$p" >/dev/null 2>&1 || true
      sleep 1
    done
  fi

  echo
  echo "完成 ✅ \"$SCREEN_NAME\" = ${S_RES}（主屏$( [[ $NO_MIRROR == false ]] && echo '，物理屏已镜像' || echo '，扩展模式')）"
  echo
  show_status
}

do_off() {
  ensure_bd
  echo "恢复纯物理显示（断开虚拟屏、解除镜像）..."
  local alltags vtags phys
  alltags=$(list_displays | cut -f1)
  for t in ${(f)alltags}; do unmirror "$t"; done
  sleep 2
  vtags=$(list_displays | awk -F'\t' '$2=="VirtualScreen" {print $1}')
  for t in ${(f)vtags}; do
    "$BD" set -tagID="$t" -connected=off >/dev/null 2>&1 || true
  done
  phys=$(physical_tags | head -1)
  if [[ -n "$phys" ]]; then
    "$BD" set -tagID="$phys" -main=on >/dev/null 2>&1 || true
  fi
  echo "完成 ✅"
  echo
  show_status
}

# 版本比较：$1 是否严格新于 $2
# 返回 0=更新 / 1=不新（更旧或相同）/ 2=无法比较（段数超界或非纯数字段）
# 接受 1–4 段数字并补齐（"2.0" ≡ "2.0.0.0"）；段值经 10# 归一防前导零按八进制解析
ver_newer() {
  local -a a b A B
  local i
  a=("${(@s/./)1}") b=("${(@s/./)2}")
  (( ${#a[@]} >= 1 && ${#a[@]} <= 4 )) || return 2
  (( ${#b[@]} >= 1 && ${#b[@]} <= 4 )) || return 2
  for i in "${a[@]}"; do [[ "$i" == <-> ]] || return 2; done
  for i in "${b[@]}"; do [[ "$i" == <-> ]] || return 2; done
  for i in "${a[@]}"; do A+=( $(( 10#$i )) ); done
  for i in "${b[@]}"; do B+=( $(( 10#$i )) ); done
  while (( ${#A[@]} < 4 )); do A+=(0); done
  while (( ${#B[@]} < 4 )); do B+=(0); done
  for i in 1 2 3 4; do
    if (( A[i] > B[i] )); then return 0
    elif (( A[i] < B[i] )); then return 1; fi
  done
  return 1
}

do_update() {
  local tmp remote_ver
  tmp=$(mktemp)
  echo "检查更新 ..."
  curl -fsSL --connect-timeout 10 --max-time 30 "$RAW_URL" -o "$tmp" \
    || { echo "错误：下载失败（${RAW_URL}）——请检查网络后重试" >&2; rm -f "$tmp"; exit 1; }
  remote_ver=$(sed -n 's/^VERSION="\([^"]*\)".*/\1/p' "$tmp" | head -1)
  if [[ -z "$remote_ver" ]]; then
    echo "⚠️  无法解析远端版本号，跳过更新" >&2
    rm -f "$tmp"
    return
  fi
  if [[ "$remote_ver" == "$VERSION" ]]; then
    echo "已是最新版本 v$VERSION ✅"
    rm -f "$tmp"
    return
  fi
  # 只升不降：远端不比本地新（更旧 / 无法比较）时拒绝覆盖
  local rc=0
  ver_newer "$remote_ver" "$VERSION" || rc=$?
  if (( rc == 2 )); then
    echo "跳过：远端版本 \"$remote_ver\" 无法比较（本地 v${VERSION}），未覆盖"
    rm -f "$tmp"
    return
  fi
  if (( rc == 1 )); then
    echo "跳过：本地 v$VERSION 不旧于远端 v${remote_ver}（远端可能是缓存旧版，未覆盖）"
    rm -f "$tmp"
    return
  fi
  chmod +x "$tmp"
  mv "$tmp" "$SCRIPT_PATH" \
    || { rm -f "$tmp"; echo "错误：无法写入 ${SCRIPT_PATH}（权限？）" >&2; exit 1; }
  echo "已更新 v$VERSION -> v$remote_ver ✅（重新运行即生效）"
}

# ---------- 执行 ----------
case "$MODE" in
  apply)   do_apply ;;
  off)     do_off ;;
  status)  ensure_bd; show_status ;;
  list)    do_list ;;
  update)  do_update ;;
  version) echo "vscreen v$VERSION" ;;
esac
